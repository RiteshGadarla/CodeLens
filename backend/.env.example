SERVER_PORT=8090

# postgres (shared with the postgres container)
POSTGRES_DB=codelens
POSTGRES_USER=codelens
POSTGRES_PASSWORD=codelens
DB_HOST=localhost
DB_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

AI_SERVICE_URL=http://localhost:8000
REPOS_DIR=./data/repos

# auth: >= 32 bytes, e.g. openssl rand -base64 48; blank = random per start
JWT_SECRET=
# local dirs and file: git urls read the server disk
ALLOW_LOCAL_PATHS=true
